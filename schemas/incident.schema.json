{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucaslapinho/ai-soc-investigator/schemas/incident.schema.json",
  "title": "SOC AI Investigator incident 0.1.0",
  "description": "Contrato local de relatório; não é schema nativo Cortex, Graph, OCSF ou ECS. Dados precisam de validação semântica adicional.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "context": {
      "type": "object",
      "properties": {
        "tenant_ref": {
          "type": "string",
          "minLength": 1
        },
        "original_timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scope_description": {
          "type": "string",
          "minLength": 1
        },
        "data_handling": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_ref",
        "original_timezone",
        "scope_description",
        "data_handling"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "string",
      "enum": [
        "MALICIOUS",
        "BENIGN",
        "SUSPICIOUS"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "Informational",
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "investigation_status": {
      "type": "string",
      "enum": [
        "Complete",
        "Incomplete",
        "Requires Human Review"
      ]
    },
    "justification": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "severity_reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "evidence_ids",
        "severity_reason",
        "confidence_reason"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        },
        "supporting_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "opposing_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "opposing_assessment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "items",
        "supporting_ids",
        "opposing_ids",
        "opposing_assessment"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "tenant_ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "access_status": {
            "type": "string",
            "enum": [
              "Provided",
              "Connected",
              "Unavailable"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "product",
          "tenant_ref",
          "locator",
          "coverage",
          "access_status",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      },
      "minItems": 0
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "Host",
              "Endpoint",
              "User",
              "IP",
              "Domain",
              "URL",
              "Hash",
              "Process",
              "Session",
              "CloudResource",
              "Email",
              "Other"
            ]
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "tenant_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "type",
          "namespace",
          "value",
          "tenant_ref",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "original_time": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "original_timezone": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "precision": {
            "type": "string",
            "enum": [
              "Exact",
              "Approximate",
              "Unknown"
            ]
          },
          "clock_skew_notes": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "Observation",
              "Inference",
              "Hypothesis"
            ]
          }
        },
        "required": [
          "id",
          "time_utc",
          "original_time",
          "original_timezone",
          "precision",
          "clock_skew_notes",
          "event",
          "entity_ids",
          "evidence_ids",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "attack": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://attack\\.mitre\\.org/techniques/"
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "source_url",
          "verified_on",
          "evidence_ids",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scope": {
      "type": "object",
      "properties": {
        "confirmed_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "potential_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "confirmed_entity_ids",
        "potential_entity_ids",
        "coverage",
        "limitations"
      ],
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Confirmed",
            "Potential",
            "None Observed",
            "Unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "description",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "next_step": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "priority",
          "owner",
          "next_step"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "minItems": 0
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "accessed_on",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "category",
    "created_at",
    "updated_at",
    "context",
    "classification",
    "severity",
    "confidence",
    "investigation_status",
    "justification",
    "evidence",
    "sources",
    "queries",
    "entities",
    "timeline",
    "attack",
    "scope",
    "impact",
    "gaps",
    "actions",
    "human_approval_required",
    "next_steps",
    "references"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_time": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "original_timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "Observation",
            "Inference",
            "Hypothesis"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "integrity_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "locator",
        "observed_at",
        "original_time",
        "original_timezone",
        "collected_at",
        "collector",
        "kind",
        "summary",
        "sha256",
        "integrity_notes"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_ref": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "Planned",
            "Executed",
            "Failed",
            "Unavailable",
            "Partial"
          ]
        },
        "executed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "coverage_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "tenant_ref",
        "language",
        "expression",
        "status",
        "executed_at",
        "result_ref",
        "row_count",
        "error",
        "coverage_notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "Planned",
                  "Unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "executed_at": {
                "type": "null"
              },
              "result_ref": {
                "type": "null"
              },
              "row_count": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "Executed",
                  "Partial"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "executed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "result_ref": {
                "type": "string",
                "minLength": 1
              },
              "row_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "Executed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "Failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "executed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "Approved",
            "Rejected"
          ]
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "decision",
        "approver",
        "approved_at",
        "expires_at",
        "tenant_ref",
        "target_entity_ids",
        "scope"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "Confirmed",
            "Failed",
            "Unknown"
          ]
        },
        "verification_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "tool",
        "request_ref",
        "result_ref",
        "verification_status",
        "verification_evidence_ids"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "Proposed",
            "Approved",
            "Rejected",
            "Executed",
            "Failed",
            "Unknown"
          ]
        },
        "tenant_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "effect": {
          "type": "string",
          "enum": [
            "ExternalWrite",
            "ExternalDisclosure"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "justification_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "human_approval_required": {
          "const": true
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "impact_assessment": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/execution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "status",
        "tenant_ref",
        "target_entity_ids",
        "effect",
        "description",
        "justification_evidence_ids",
        "human_approval_required",
        "approval",
        "preconditions",
        "impact_assessment",
        "rollback",
        "executor",
        "execution"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
